NODE_ENV=production
HOST=127.0.0.1
PORT=3333
ENV_FILE=/etc/erpxadquirente/backend.env
STORAGE_DIR=/var/lib/erpxadquirente/storage
DATABASE_URL=postgresql://erpxadquirente:SUBSTITUA_SENHA_DB@127.0.0.1:5432/erpxadquirente
DATABASE_AUTO_CREATE=false
AUTH_SECRET=SUBSTITUA_AUTH_SECRET
SFTP_ENCRYPTION_KEY=SUBSTITUA_SFTP_ENCRYPTION_KEY
# Somente instalação NOVA; remova esta linha ao atualizar banco com usuários existentes.
ADMIN_INITIAL_PASSWORD=SUBSTITUA_SENHA_INICIAL
AUTH_TOKEN_TTL_SECONDS=28800
CORS_ORIGINS=https://SEU_DOMINIO
TRUST_PROXY=loopback
# Mínimo 4; 12 é o ponto de partida, a ajustar após medição no servidor.
POSTGRES_POOL_MAX=12
POSTGRES_CONNECTION_TIMEOUT_MS=10000
POSTGRES_STATEMENT_TIMEOUT_MS=120000
POSTGRES_TRANSACTION_IDLE_TIMEOUT_MS=120000
RATE_LIMIT_PER_MINUTE=600
LOGIN_RATE_LIMIT_PER_15_MINUTES=5
UPLOAD_MAX_MB=50
PARSER_TIMEOUT_MS=30000
PARSER_MEMORY_MB=256
PARSER_MAX_ROWS=200000
PARSER_MAX_CELLS=2000000
RETENCAO_PROCESSADOS_DIAS=0
RETENCAO_ERROS_DIAS=0
RETENCAO_LOGS_DIAS=30
IMPORTACOES_WATCHER_ENABLED=true
IMPORTACOES_WATCHER_INTERVAL_MS=5000
IMPORTACOES_WATCHER_MAX_POR_VARREDURA=10
IMPORTACOES_FECHAMENTO_LOTE_MS=120000
SHUTDOWN_TIMEOUT_MS=300000
REMOTE_EDI_ENABLED=false
REMOTE_EDI_HOST=SUBSTITUA_HOST_SFTP
REMOTE_EDI_PORT=22
REMOTE_EDI_HOST_FINGERPRINT=SUBSTITUA_FINGERPRINT
# Copie os REMOTE_EDI_<ADQUIRENTE>_USER e diretórios da configuração atual validada.
# Ative REMOTE_EDI_ENABLED somente depois de conferir todos os usuários e fingerprints.

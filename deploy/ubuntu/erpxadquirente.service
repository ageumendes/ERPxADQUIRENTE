[Unit]
Description=ERPxADQUIRENTE backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=erpxadquirente
Group=erpxadquirente
WorkingDirectory=/opt/erpxadquirente/current/backend
EnvironmentFile=/etc/erpxadquirente/backend.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/erpxadquirente/current/backend/dist/server.js
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=320
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/erpxadquirente /var/log/erpxadquirente
SyslogIdentifier=erpxadquirente
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

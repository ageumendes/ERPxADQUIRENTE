PORT=3333

# Use PostgreSQL when DATABASE_URL is set. Leave empty to use local JSON storage.
DATABASE_URL=postgresql://erpxadquirente:erpxadquirente@127.0.0.1:5432/erpxadquirente
POSTGRES_ADMIN_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
PERSISTENCIA_POSTGRES=true

# Import watcher
IMPORTACOES_WATCHER_ENABLED=true
IMPORTACOES_WATCHER_INTERVAL_MS=5000
IMPORTACOES_WATCHER_MAX_POR_VARREDURA=10
IMPORTACOES_FILA_PAUSA_ENTRE_ARQUIVOS_MS=25
IMPORTACOES_RECUPERAR_MAX_BOOT=50
IMPORTACOES_RECUPERAR_MAX_MANUAL=50

# Remote EDI/SFTP
REMOTE_EDI_ENABLED=false
REMOTE_EDI_HOST=
REMOTE_EDI_PORT=22
REMOTE_EDI_PRIVATE_KEY_PATH=
REMOTE_EDI_SIPAG_USUARIO=
REMOTE_EDI_SIPAG_PASSWORD=
REMOTE_EDI_SICREDI_USUARIO=
REMOTE_EDI_SICREDI_PASSWORD=
REMOTE_EDI_CIELO_USUARIO=
REMOTE_EDI_CIELO_PASSWORD=
REMOTE_EDI_CONVCARD_USUARIO=
REMOTE_EDI_CONVCARD_PASSWORD=

# Sicoob PSP PIX
SICOOB_ENV=sandbox
SICOOB_CLIENT_ID=
SICOOB_SCOPE=
SICOOB_AUTH_URL=https://auth.sicoob.com.br/auth/realms/cooperado/protocol/openid-connect/token
SICOOB_PIX_SANDBOX_URL=https://sandbox.sicoob.com.br/sicoob/sandbox/pix/api/v2
SICOOB_PIX_PRODUCTION_URL=https://api.sicoob.com.br/pix/api/v2
SICOOB_PFX_PATH=
SICOOB_CERT_PATH=
SICOOB_KEY_PATH=
SICOOB_CERT_PASSPHRASE=

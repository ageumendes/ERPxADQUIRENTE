{
  "name": "erpxadquirente-backend",
  "version": "0.1.241",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:watch": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "test:startup": "node scripts/verificar-imports-esm.mjs",
    "test": "tsc -p tsconfig.test.json && tsx --test test/*.test.ts",
    "test:compiled": "tsc -p tsconfig.test.json --noEmit false --outDir .test-dist && node --test .test-dist/test/*.test.js",
    "test:postgres": "TEST_DATABASE_URL=${TEST_DATABASE_URL:?Defina TEST_DATABASE_URL para um banco exclusivo de testes} tsx --test test/postgres/*.test.ts",
    "corrigir:vendas": "tsx src/cli/corrigir-vendas.ts",
    "limpar:historico": "node scripts/limpar-historico-interrompido.mjs",
    "auditar:sipag": "node scripts/auditar-importacao-sipag.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "multer": "^2.2.0",
    "pg": "^8.12.0",
    "ssh2-sftp-client": "^11.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.30",
    "@types/pg": "^8.11.6",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2"
  }
}

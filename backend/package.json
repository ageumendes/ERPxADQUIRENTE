{
  "name": "erpxadquirente-backend",
  "version": "0.1.254",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:watch": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc && node scripts/build-assets.mjs",
    "test:startup": "node scripts/verificar-imports-esm.mjs",
    "test": "npm run test:compiled",
    "test:compiled": "tsc -p tsconfig.test.json --noEmit false --outDir .test-dist && node scripts/build-assets.mjs && node --test .test-dist/test/*.test.js",
    "test:postgres": "TEST_DATABASE_URL=${TEST_DATABASE_URL:?Defina TEST_DATABASE_URL para um banco exclusivo de testes} node --import tsx --test test/postgres/*.test.ts",
    "corrigir:vendas": "node dist/cli/corrigir-vendas.js",
    "limpar:historico": "node scripts/limpar-historico-interrompido.mjs",
    "auditar:sipag": "node scripts/auditar-importacao-sipag.mjs",
    "check:release": "node scripts/verificar-pacote.mjs",
    "verificar:producao": "node scripts/verificar-producao.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "4.22.3",
    "multer": "2.4.0",
    "pg": "^8.12.0",
    "ssh2-sftp-client": "^11.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.30",
    "@types/pg": "^8.11.6",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}

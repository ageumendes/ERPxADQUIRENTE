{
  "name": "erpxadquirente",
  "version": "0.1.69",
  "private": true,
  "description": "ERPxADQUIRENTE - Conciliação ERP INTERDATA x Adquirentes",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "install:all": "npm install && npm --prefix frontend install && npm --prefix backend install",
    "setup": "npm run install:all && npm run preparar:pastas",
    "preparar:pastas": "node scripts/preparar-pastas.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:bootstrap": "bash scripts/bootstrap-postgres-local.sh",
    "db:bootstrap:local": "bash scripts/bootstrap-postgres-local.sh"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
